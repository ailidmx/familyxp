{
  "name": "familyxp",
  "private": true,
  "type": "module",
  "scripts": {
    "env:list": "node scripts/env-manager.mjs list",
    "env:show": "node scripts/env-manager.mjs show",
    "env:use": "node scripts/env-manager.mjs use",
    "dev": "nuxi dev",
    "dev:active": "nuxi dev --dotenv .env.active",
    "dev:local": "nuxi dev --dotenv .env.local",
    "dev:dev": "nuxi dev --dotenv .env.dev",
    "dev:uat": "nuxi dev --dotenv .env.uat",
    "dev:prod": "nuxi dev --dotenv .env.prod",
    "build": "nuxi build",
    "build:active": "nuxi build --dotenv .env.active",
    "build:dev": "nuxi build --dotenv .env.dev",
    "build:uat": "nuxi build --dotenv .env.uat",
    "build:prod": "nuxi build --dotenv .env.prod",
    "generate": "nuxi generate",
    "preview": "nuxi preview",
    "postinstall": "nuxi prepare",
    "prepare": "nuxi prepare",
    "dev:prepare": "nuxi prepare",
    "lint": "eslint . --ext .vue,.ts,.js",
    "lint:fix": "eslint . --ext .vue,.ts,.js --fix",
    "check:i18n": "node scripts/check-i18n-no-magic-strings.mjs",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "seed": "npx tsx scripts/seed.ts",
    "emulators": "firebase emulators:start --import=./firebase-data --export-on-exit",
    "emulators:seed": "firebase emulators:start --import=./firebase-data",
    "deploy:dev": "firebase deploy --project familyxp-dev",
    "deploy:uat": "firebase deploy --project familyxp-uat",
    "deploy:prod": "firebase deploy --project familyxp-prod"
  },
  "dependencies": {
    "@nuxtjs/i18n": "^9.5.0",
    "@pinia/nuxt": "^0.9.0",
    "@vueuse/core": "^11.0.0",
    "@vueuse/nuxt": "^11.0.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "firebase": "^11.0.0",
    "lucide-vue-next": "^0.460.0",
    "nuxt": "^3.15.0",
    "pinia": "^2.3.0",
    "radix-vue": "^1.9.0",
    "tailwind-merge": "^2.6.0",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@nuxtjs/eslint-config-typescript": "^12.1.0",
    "@nuxtjs/eslint-module": "^4.1.0",
    "@playwright/test": "^1.49.0",
    "@vue/test-utils": "^2.4.0",
    "autoprefixer": "^10.5.2",
    "eslint": "^8.57.0",
    "firebase-admin": "^14.1.0",
    "firebase-tools": "^13.0.0",
    "happy-dom": "^15.0.0",
    "husky": "^9.1.0",
    "lint-staged": "^15.3.0",
    "postcss": "^8.5.15",
    "postcss-import": "^16.1.1",
    "prettier": "^3.4.0",
    "prettier-plugin-tailwindcss": "^0.6.0",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0",
    "vue-tsc": "^2.2.0"
  },
  "lint-staged": {
    "*.{vue,ts,js}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "engines": {
    "node": "20.x"
  }
}
