# =============================================================================
# ENVIRONNEMENT PRODUCTION - Firebase Project (familyxp-prod)
# =============================================================================
# Projet Firebase de production.
# Lancer avec : npm run dev:prod
# URL de déploiement : https://familyxp.app

NUXT_PUBLIC_FIREBASE_API_KEY=AIzaSyPROD_EXAMPLE_API_KEY
NUXT_PUBLIC_FIREBASE_AUTH_DOMAIN=familyxp-prod.firebaseapp.com
NUXT_PUBLIC_FIREBASE_PROJECT_ID=familyxp-prod
NUXT_PUBLIC_FIREBASE_STORAGE_BUCKET=familyxp-prod.appspot.com
NUXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1000000000003
NUXT_PUBLIC_FIREBASE_APP_ID=1:1000000000003:web:prod0000000000000003

# Mode debug
NUXT_PUBLIC_APP_ENV=prod
NUXT_PUBLIC_DEBUG=false
