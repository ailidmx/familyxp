# Firebase Configuration
# Obtenir ces valeurs depuis la console Firebase > Project Settings > General > Your apps > Web app

# --- Production Firebase Project ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- Firebase Emulator (développement local) ---
# Laisser à true pour utiliser les émulateurs Firebase en développement
VITE_USE_FIREBASE_EMULATORS=true

# Ports des émulateurs (par défaut)
VITE_FIREBASE_AUTH_EMULATOR_PORT=9099
VITE_FIREBASE_FIRESTORE_EMULATOR_PORT=8080
VITE_FIREBASE_STORAGE_EMULATOR_PORT=9199

# --- Application ---
VITE_APP_NAME=FamilyXP
VITE_APP_URL=http://localhost:3000

# --- Feature Flags ---
VITE_ENABLE_PREMIUM=false
VITE_ENABLE_AI_CONTRACT=false
