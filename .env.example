# =============================================================================
# FamilyXP / FamQuest - Configuration d'environnement
# =============================================================================
# Ce fichier sert de référence pour tous les environnements.
# Copier vers .env.local, .env.dev, .env.uat ou .env.prod selon le besoin.
#
# 4 environnements disponibles :
#   LOCAL  → Firebase Emulators (aucun projet réel requis)
#   DEV    → Projet Firebase familyxp-dev
#   UAT    → Projet Firebase familyxp-uat
#   PROD   → Projet Firebase familyxp-prod
#
# Pour lancer un environnement spécifique :
#   npm run dev:local   → utilise .env.local
#   npm run dev:dev     → utilise .env.dev
#   npm run dev:uat     → utilise .env.uat
#   npm run dev:prod    → utilise .env.prod
# =============================================================================

# ─── Firebase Configuration ──────────────────────────────────────────────────
# Ces valeurs proviennent de la console Firebase > Paramètres du projet > Général
# Section "Mes applications" > "Applications Web"

NUXT_PUBLIC_FIREBASE_API_KEY=AIzaSyXXXXXXXXXX
NUXT_PUBLIC_FIREBASE_AUTH_DOMAIN=familyxp-XXXXX.firebaseapp.com
NUXT_PUBLIC_FIREBASE_PROJECT_ID=familyxp-XXXXX
NUXT_PUBLIC_FIREBASE_STORAGE_BUCKET=familyxp-XXXXX.appspot.com
NUXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NUXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:XXXXXXXXXXXXXX

# ─── Environnement ───────────────────────────────────────────────────────────
# Valeurs possibles : local | dev | uat | prod

NUXT_PUBLIC_APP_ENV=local

# ─── Debug ───────────────────────────────────────────────────────────────────
# true en local/dev, false en uat/prod

NUXT_PUBLIC_DEBUG=true

# ─── Firebase Emulators (LOCAL uniquement) ───────────────────────────────────
# Utilisés automatiquement quand NUXT_PUBLIC_APP_ENV=local
# Ports par défaut des émulateurs Firebase

NUXT_PUBLIC_FIRESTORE_EMULATOR_HOST=localhost:8080
NUXT_PUBLIC_AUTH_EMULATOR_HOST=http://localhost:9099
NUXT_PUBLIC_STORAGE_EMULATOR_HOST=localhost:9199

# ─── Firebase Functions (optionnel, futur) ───────────────────────────────────
# NUXT_PUBLIC_FIREBASE_FUNCTIONS_HOST=http://localhost:5001
