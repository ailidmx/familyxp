NUXT_PUBLIC_FIREBASE_API_KEY=AIzaSyUAT_EXAMPLE_API_KEY
NUXT_PUBLIC_FIREBASE_AUTH_DOMAIN=familyxp-uat.firebaseapp.com
NUXT_PUBLIC_FIREBASE_PROJECT_ID=familyxp-uat
NUXT_PUBLIC_FIREBASE_STORAGE_BUCKET=familyxp-uat.appspot.com
NUXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1000000000002
NUXT_PUBLIC_FIREBASE_APP_ID=1:1000000000002:web:uat0000000000000002

# Mode debug
NUXT_PUBLIC_APP_ENV=uat
NUXT_PUBLIC_DEBUG=false
